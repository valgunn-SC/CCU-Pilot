rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IMPORTANT : remplace l'adresse ci-dessous par la même adresse Google
    // que dans firebase-config.js, en minuscules.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'REMPLACER_PAR_TON_ADRESSE_GOOGLE_EN_MINUSCULES';
    }

    match /users/{userId}/app/{document=**} {
      allow read, write: if isOwner() && request.auth.uid == userId;
    }

    // Tout ce qui n'est pas explicitement autorisé ci-dessus est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
